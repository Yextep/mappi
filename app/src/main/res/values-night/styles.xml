<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Un tema oscuro hace que la página reciba prefers-color-scheme: dark. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0D1312</item>
        <item name="android:navigationBarColor">#172120</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>
    <color name="fondo">#0D1312</color>
</resources>
